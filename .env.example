# ==============================================================================
# Awaaz Multi-User SaaS — Environment Configuration Example
# Copy to .env (root or backend/.env and frontend/.env.local).
# NEVER commit real secrets or API keys.
# ==============================================================================

# --- Runtime & Modes ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Data & Auth modes:
# Production MUST use DATA_STORE_MODE=supabase and AUTH_MODE=supabase.
# Local development without Supabase credentials may use memory + dev_local.
DATA_STORE_MODE=memory
AUTH_MODE=dev_local
DEV_AUTH_SECRET=replace-with-32-char-local-dev-secret-only

# --- Supabase (Required for Production) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=awaaz-private-documents

# --- Frontend Public Variables (frontend/.env.local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini, Groq & GitHub Models AI (Server-only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_MS=20000

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# --- Speech Provider (Server-only, replaceable adapter) ---
# Options: auto | groq | gemini | lingoscribe | unconfigured
VOICE_PROVIDER=auto
VOICE_PROVIDER_BASE_URL=
LINGOSCRIBE_API_KEY=
LINGOSCRIBE_STT_PATH=/v1/transcribe
LINGOSCRIBE_TTS_PATH=/v1/synthesize
VOICE_REQUEST_TIMEOUT_MS=20000

# --- Phone OTP Verification Provider (Server-only) ---
# Options: unconfigured | supabase_sms
# Production requires supabase_sms with Supabase Phone Auth / SMS credentials configured.
OTP_PROVIDER=unconfigured

# --- Rate Limiting & Upload Limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AI_RATE_LIMIT_MAX_REQUESTS=30
MAX_UPLOAD_SIZE_MB=5
MAX_AUDIO_SIZE_MB=4
